{
  "name": "sqlsure",
  "version": "0.2.0",
  "description": "Import .sql files in TypeScript and get types Postgres itself vouches for. A TypeScript 7.1 content mapper. No codegen.",
  "license": "MIT",
  "author": "Afshin Jalili",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AfshinJalili/sqlsure.git"
  },
  "keywords": [
    "sql",
    "postgres",
    "postgresql",
    "typescript",
    "content-mapper",
    "types",
    "pg",
    "sqlc"
  ],
  "type": "module",
  "engines": {
    "node": "^22.22.0 || >=24.10.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./esbuild": {
      "types": "./dist/esbuild.d.ts",
      "default": "./dist/esbuild.js"
    },
    "./bun": {
      "types": "./dist/bun.d.ts",
      "default": "./dist/bun.js"
    },
    "./package.json": "./package.json"
  },
  "typescript": {
    "contentMapper": {
      "exec": [
        "node",
        "dist/mapper-main.js"
      ],
      "compilerOptions": [],
      "dynamicConfig": true
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test 'tests/**/*.test.ts'",
    "evals": "npm run build && node evals/run.ts",
    "evals:quick": "npm run build && node evals/run.ts --skip-corpus --skip-perf",
    "smoke": "node evals/smoke.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.11",
    "libpg-query": "18.2.0"
  },
  "peerDependencies": {
    "@electric-sql/pglite-age": "0.0.12",
    "@electric-sql/pglite-pg_hashids": "0.0.12",
    "@electric-sql/pglite-pg_ivm": "0.0.12",
    "@electric-sql/pglite-pg_textsearch": "0.0.13",
    "@electric-sql/pglite-pg_uuidv7": "0.0.12",
    "@electric-sql/pglite-pgtap": "0.0.12",
    "@electric-sql/pglite-pgvector": "0.0.12",
    "@electric-sql/pglite-postgis": "0.2.11",
    "typescript": ">=7.1.0-beta"
  },
  "peerDependenciesMeta": {
    "@electric-sql/pglite-age": {
      "optional": true
    },
    "@electric-sql/pglite-pg_hashids": {
      "optional": true
    },
    "@electric-sql/pglite-pg_ivm": {
      "optional": true
    },
    "@electric-sql/pglite-pg_textsearch": {
      "optional": true
    },
    "@electric-sql/pglite-pg_uuidv7": {
      "optional": true
    },
    "@electric-sql/pglite-pgtap": {
      "optional": true
    },
    "@electric-sql/pglite-pgvector": {
      "optional": true
    },
    "@electric-sql/pglite-postgis": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@electric-sql/pglite-pgvector": "0.0.12",
    "@electric-sql/pglite-postgis": "0.2.11",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "typescript": "7.1.0-beta"
  }
}
